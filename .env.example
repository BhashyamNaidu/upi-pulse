# Copy to .env (gitignored) and fill in. Never commit .env.
UPI_PULSE_ENV=local
# Local default is ./data/lake. For Azure: abfss://<container>@<account>.dfs.core.windows.net/
UPI_PULSE_LAKE_ROOT=
# Polite scraping identity (Phase 1)
UPI_PULSE_USER_AGENT=upi-pulse-portfolio-project (+https://github.com/BhashyamNaidu/upi-pulse)
# Optional failure alerts (Phase 4)
ALERT_SLACK_WEBHOOK_URL=
# Optional data.gov.in API key (Phase 1, only if used)
DATA_GOV_IN_API_KEY=
